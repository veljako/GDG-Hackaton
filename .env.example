# Copy to .env.server.local. Never put Admin credentials in VITE_ variables.
GEVENTS_BACKEND_MODE=demo
GEVENTS_API_PORT=5181
GEVENTS_API_HOST=127.0.0.1
# Optional HTTPS API origin for a Firebase-hosted frontend (set before build).
VITE_API_ORIGIN=
# Exact trusted frontend origins for separate hosting or a reverse proxy.
GEVENTS_ALLOWED_ORIGINS=
# Firebase mode additionally requires Google Application Default Credentials.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
# Existing private Cloud Storage bucket for CV PDFs; optional until provisioned.
FIREBASE_STORAGE_BUCKET=
# Demo only: persistent private CV files, outside public/ and dist/.
GEVENTS_CV_DIRECTORY=.runtime/backend/private-cvs
# Comma-separated actual Firebase UIDs. Browser role switches cannot grant this.
GEVENTS_ORGANIZER_UIDS=
