{
  "name": "gevents-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5180 --strictPort",
    "test": "vitest run",
    "check": "npm run test && npm run server:check && npm run build",
    "dev:frontend": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "server": "tsx server/index.ts",
    "server:check": "tsc -p tsconfig.server.json",
    "server:firebase": "node --env-file=.env.firebase.local --import tsx server/index.ts",
    "firebase:import": "tsx server/import-firebase.ts",
    "firebase:check": "tsx server/check-firebase.ts",
    "firebase:export-training": "tsx server/export-training.ts",
    "firebase:vectors": "tsx server/manage-embeddings.ts"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource-variable/roboto": "^5.2.0",
    "@material/web": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "sonner": "^2.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
